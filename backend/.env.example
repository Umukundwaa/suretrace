PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
PUBLIC_BASE_URL=http://localhost:4000

# DB_CLIENT=mysql for real deployment, sqlite for quick local runs
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=suretrace
SQLITE_FILE=./suretrace.sqlite

INSURER_API_URL=http://localhost:4001
INSURER_API_KEY=dev-insurer-key

# true shows a small "simulated insurer data" notice. Set to false once a real insurer/ASSAR feed is connected.
DEMO_MODE=true
